# This file contains the fastlane.tools configuration
# Documentation: https://docs.fastlane.tools

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    setup_ci if ENV['CI']
    api_key = load_api_key
    match(type: 'appstore')
    update_build_number
    build_app(scheme: "SwiftNZB")
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  # Build + upload a release to the App Store: binary AND the listing metadata under
  # fastlane/metadata (name/subtitle/description/keywords/notes, en-US + de-DE).
  #
  # This deliberately does NOT auto-submit for review. A reviewer can't test the app without a
  # demo Usenet account and a demo .nzb file, and the demo NZB has to be attached in the App Store
  # Connect UI (fastlane can't). So this uploads everything it can, then you finish in App Store
  # Connect: add screenshots (if not shipping them from ./fastlane/screenshots), attach the demo
  # NZB, select all three Pro products under "In-App Purchases and Subscriptions" (Apple requires
  # an app's first in-app purchase to ride an app version, and deliver cannot attach them), and
  # press Submit. Full checklist: docs/AppStoreReview.md.
  desc "Build and upload a release (binary + metadata) to the App Store. Does not auto-submit."
  lane :release do
    setup_ci if ENV['CI']
    api_key = load_api_key
    match(type: 'appstore')
    update_build_number
    build_app(scheme: "SwiftNZB")
    upload_to_app_store(
      api_key: api_key,
      metadata_path: "./fastlane/metadata",
      # Name the version, as the :metadata lane does. Without it deliver derives the version and
      # tries to create it, which App Store Connect rejects with "You cannot create a new version
      # of the App in the current state" plus "The version number has been previously used" the
      # moment a draft for that version already exists in App Store Connect.
      app_version: get_version_number(xcodeproj: "SwiftNZB.xcodeproj", target: "SwiftNZB"),
      # No screenshots are committed yet. Add them under ./fastlane/screenshots and drop this flag
      # to have fastlane upload them, or upload them manually in App Store Connect.
      skip_screenshots: true,
      # Upload only — see the note above. Submit in App Store Connect after attaching the demo NZB.
      submit_for_review: false,
      # Stays false: precheck cannot read in-app purchases under App Store Connect API-key auth,
      # so flipping it buys nothing and can fail the upload. Read the three product descriptions
      # by hand instead (no URLs, no platform names, no placeholder text).
      precheck_include_in_app_purchases: false,
      # Skip the interactive HTML metadata-preview confirmation so the lane runs unattended.
      force: true
    )
  end

  # Composed App Store screenshots, built locally. No App Store Connect access, nothing uploaded.
  #
  # There is no UITest target and none is needed: the lane seeds the app's own persisted state
  # (jobs.v1.json plus the free-download counter) and opens the right tab with a DEBUG-only
  # `-startSection` launch argument, so no taps are driven and every shot is reproducible. The
  # queue shot is a real download against whatever server the simulator has configured, and the
  # capture waits for decoded bytes rather than a fixed delay.
  #
  # The device must be an iPhone 17 or 17 Pro: the bezel's aperture is exactly 1206x2622, so the
  # capture drops in 1:1 with no resampling.
  desc "Build composed 6.5-inch App Store screenshots into fastlane/screenshots (local only)."
  lane :screenshots do |options|
    sim = options[:sim] || ENV["SCREENSHOT_SIM"]
    UI.user_error!("pass sim:<udid> (a booted-capable iPhone 17/17 Pro with a Usenet server set up)") unless sim
    nzb = options[:nzb] || File.expand_path("~/Downloads/test_download_1000MB.nzb")
    bezel = options[:bezel] || File.expand_path("~/Downloads/iPhone 17 - Mist Blue - Portrait.png")
    background = options[:background] || File.expand_path("~/Downloads/background.png")
    [nzb, bezel, background].each { |f| UI.user_error!("missing #{f}") unless File.exist?(f) }

    # Debug, because the -startSection argument and the entitlement debug screen are #if DEBUG.
    derived = File.expand_path("../.build/screenshots", __dir__)
    sh("xcodebuild", "-project", "../SwiftNZB.xcodeproj", "-scheme", "SwiftNZB",
       "-configuration", "Debug", "-sdk", "iphonesimulator",
       "-derivedDataPath", derived, "CODE_SIGNING_ALLOWED=NO", "build")
    app = File.join(derived, "Build/Products/Debug-iphonesimulator/SwiftNZB.app")
    UI.user_error!("build produced no app at #{app}") unless Dir.exist?(app)

    sh(*["python3", File.expand_path("screenshot/shoot.py", __dir__),
         "--sim", sim, "--app", app, "--nzb", nzb, "--bezel", bezel,
         "--background", background,
         "--out", File.expand_path("../fastlane/screenshots/en-US", __dir__),
         "--states", (options[:states] || "queue,history,settings")])
    UI.success("screenshots in fastlane/screenshots/en-US")
  end

  # Listing texts only, no build. Same metadata as :release, minus the binary — use it when only
  # fastlane/metadata changed. Does not submit for review.
  desc "Upload only the listing metadata under fastlane/metadata (no build)."
  lane :metadata do
    api_key = load_api_key
    upload_to_app_store(
      api_key: api_key,
      metadata_path: "./fastlane/metadata",
      # Without this, deliver looks for an already-editable App Store version and spins on
      # "Cannot find edit app store version". Naming it makes deliver create the version.
      app_version: get_version_number(xcodeproj: "SwiftNZB.xcodeproj", target: "SwiftNZB"),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      # Stays false: precheck cannot read in-app purchases under App Store Connect API-key auth,
      # so flipping it buys nothing and can fail the upload. Read the three product descriptions
      # by hand instead (no URLs, no platform names, no placeholder text).
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end

desc "Register the app + widget App IDs on the Apple Developer portal (one-time, before match)"
lane :register_ids do
  # Main app: create the developer-portal App ID and the App Store Connect record.
  produce(
    app_identifier: "de.valentinlehmann.swiftnzb",
    app_name: "SwiftNZB"
  )
  # Widget extension: only the developer-portal App ID is needed — app extensions don't get
  # their own App Store Connect record, so skip it.
  produce(
    app_identifier: "de.valentinlehmann.swiftnzb.widgets",
    app_name: "SwiftNZB Widgets",
    skip_itc: true
  )
end

desc "Load App Store Connect API key"
lane :load_api_key do
  app_store_connect_api_key(
    duration: 300, # This token is valid for 300s
    key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
    is_key_content_base64: true,
    in_house: false
  )
end

desc "Set build number to current date/time"
lane :update_build_number do
  build_number = Time.new.strftime("%Y%m%d%H%M")
  increment_build_number(build_number: build_number)
end
